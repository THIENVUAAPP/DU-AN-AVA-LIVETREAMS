# === TikTok LIVE ===
# Username TikTok của kênh đang live (không có dấu @), ví dụ: tiktokusername
TIKTOK_USERNAME=

# === Server ===
# Cổng chạy server nội bộ, dùng để add vào OBS Browser Source: http://localhost:PORT
PORT=8080

# Ngôn ngữ mặc định của overlay: vi hoặc en
LANG_DEFAULT=vi

# === Chế độ Demo (chỉ dùng khi phát triển/test, KHÔNG dùng khi live thật) ===
# true = server tự giả lập sự kiện Like/Comment/Gift để test toàn luồng không cần phòng live thật
# false hoặc bỏ trống = kết nối TikTok LIVE thật qua TIKTOK_USERNAME
DEMO_MODE=false

# === Trang Admin (/admin) ===
# Mật khẩu để đăng nhập bảng điều khiển Admin (Bắt đầu/Tạm dừng/Kết thúc trận,
# chỉnh cỡ nhân vật, cài đặt, lịch tự động). Nếu để trống, server tự sinh 1
# mật khẩu ngẫu nhiên và in ra console mỗi lần khởi động — nên đặt cố định ở đây.
ADMIN_PASSWORD=

# === Giọng đọc AI xướng tên người tặng quà (ElevenLabs, TÙY CHỌN) ===
# Để trống = tắt tính năng này hoàn toàn, game vẫn chạy bình thường.
# Lấy API key tại: elevenlabs.io -> Profile -> API Keys (dịch vụ TRẢ PHÍ theo số ký tự).
ELEVENLABS_API_KEY=
# ID giọng đọc muốn dùng (elevenlabs.io -> Voices -> chọn giọng -> copy Voice ID).
# Để trống sẽ dùng giọng mặc định "Rachel" của ElevenLabs.
ELEVENLABS_VOICE_ID=
