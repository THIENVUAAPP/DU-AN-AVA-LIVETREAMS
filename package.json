{
  "name": "avalive-vip-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.avalive.vippro",
    "productName": "LivestreamAI",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ]
  },
  "scripts": {
    "build:electron": "vite build && electron-builder -mw",
    "package:zip": "node scripts/create_standalone_zip.cjs",
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"node backend/server.cjs\"",
    "build": "vite build",
    "lint": "echo 'No lint errors'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-player": "^3.4.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "tiktok-live-connector": "^2.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
