{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*\\.zip)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/AvaLive_VIP_PRO_Windows.zip",
      "destination": "/AvaLive_VIP_PRO_Windows_v2.zip",
      "permanent": false
    },
    {
      "source": "/AvaLive_VIP_PRO_Mac.zip",
      "destination": "/AvaLive_VIP_PRO_Mac_v2.zip",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*\\.zip)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
