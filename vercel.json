{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Accept, Authorization, Range, Origin" },
        { "key": "Access-Control-Expose-Headers", "value": "Content-Range, Accept-Ranges, Content-Length, ETag" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/download/mac", "destination": "/api/download-mac" },
    { "source": "/download/windows", "destination": "/api/download-windows" },
    { "source": "/download/(.*)", "destination": "/api/download" },
    { "source": "/AvaLive_VIP_PRO_Mac:slug*.zip", "destination": "/api/download-mac" },
    { "source": "/AvaLive_VIP_PRO_Windows:slug*.zip", "destination": "/api/download-windows" },
    { "source": "/Livestream_AI_Software.zip", "destination": "/api/download-windows" },
    { "source": "/((?!api/|assets/|uploads/|favicon.ico).*)", "destination": "/index.html" }
  ]
}