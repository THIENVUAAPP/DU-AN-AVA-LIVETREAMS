{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/download/mac", "destination": "/api/download-mac" },
    { "source": "/download/windows", "destination": "/api/download-windows" },
    { "source": "/download/(.*)", "destination": "/api/download" },
    { "source": "/AvaLive_VIP_PRO_Mac:slug*.zip", "destination": "/api/download-mac" },
    { "source": "/AvaLive_VIP_PRO_Windows:slug*.zip", "destination": "/api/download-windows" },
    { "source": "/Livestream_AI_Software.zip", "destination": "/api/download-windows" },
    { "source": "/((?!api/|assets/|uploads/|favicon.ico).*)", "destination": "/index.html" }
  ]
}